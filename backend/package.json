{
  "name": "stremiotv-backend",
  "version": "1.0.0",
  "description": "Cloudflare Worker & D1 Backend for StremioTV sync & auth",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute stremiotv-db --local --file=./schema.sql",
    "d1:init:prod": "wrangler d1 execute stremiotv-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
